    "[15:8]": "bottom_left signed int8",
    "[7:0]": "bottom_right signed int8"
  },
  "sample_level": "sample = msb_index << (8 - input_bits)",
  "edge_policy": "if msb_index is max, interpolation fraction is forced to zero",
  "formats": [
    "mem",
    "coe"
  ]
}