{
  "source_full_lut_dir": "lut_out",
  "input_bits": 4,
  "address": "addr = {p0[7:8-input_bits], p1[7:8-input_bits], p2[7:8-input_bits]}",
  "depth_per_branch": 4096,
  "word_width_bits": 32,
  "word_order": {
    "[31:24]": "top_left signed int8",
